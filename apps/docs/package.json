{
  "name": "@bloxwap/haptic-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --workspace @bloxwap/haptic run build",
    "dev": "next dev --port 3905",
    "prebuild": "npm --workspace @bloxwap/haptic run build",
    "build": "fumadocs-mdx && next typegen && tsrs --noEmit -p . && next build",
    "postbuild": "node scripts/check-export.mjs",
    "precheck": "npm --workspace @bloxwap/haptic run build",
    "check": "fumadocs-mdx && next typegen && tsrs --noEmit && node scripts/check-snippets.mjs",
    "precheck:tsc": "npm --workspace @bloxwap/haptic run build",
    "check:tsc": "fumadocs-mdx && next typegen && tsc --noEmit && node scripts/check-snippets.mjs --tsc",
    "preview": "node scripts/preview.mjs",
    "postinstall": "fumadocs-mdx",
    "smoke": "playwright test"
  },
  "dependencies": {
    "@bloxwap/font": "0.1.4",
    "@bloxwap/haptic": "0.3.0",
    "@bloxwap/hig-contracts": "0.1.0",
    "@bloxwap/hig-react": "0.1.0",
    "@bloxwap/hig-tokens": "0.1.0",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "16.17.7",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "5.9.3"
  }
}
