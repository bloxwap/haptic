{
  "name": "@bloxwap/haptic",
  "version": "0.1.0",
  "description": "Physical-tap haptic feedback for React on iOS and vibration-capable browsers.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Bloxwap",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloxwap/haptic.git",
    "directory": "packages/haptic"
  },
  "homepage": "https://bloxwap.github.io/haptic/",
  "bugs": {
    "url": "https://github.com/bloxwap/haptic/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./feedback": {
      "import": {
        "types": "./dist/feedback.d.ts",
        "default": "./dist/feedback.js"
      },
      "require": {
        "types": "./dist/feedback.d.cts",
        "default": "./dist/feedback.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "haptic",
    "haptics",
    "react",
    "ios",
    "webkit",
    "vibration",
    "feedback"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "web-haptics": "0.0.6"
  },
  "scripts": {
    "build": "tsup",
    "pretypecheck": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:matrix": "node scripts/react-matrix.mjs",
    "size": "npm run build && node scripts/size.mjs",
    "test:browser": "playwright test",
    "pack:check": "npm run build && node scripts/pack-check.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run coverage && npm run pack:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vaul": "1.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
